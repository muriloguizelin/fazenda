datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Cargo {
  ADMIN
  GERENTE
  VETERINARIO
  OPERADOR
}

enum StatusAnimal {
  ATIVO
  MORTO
  VENDIDO
  DOENTE
}

enum Sexo {
  MACHO
  FEMEA
  DESCONHECIDO
}

model Conta {
  id        String    @id @default(cuid())
  nome      String
  fazendas  Fazenda[]
  usuarios  Usuario[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Usuario {
  id          String   @id @default(cuid())
  nome        String
  email       String   @unique
  senhaHash   String
  cargo       Cargo
  contaId     String
  conta       Conta    @relation(fields: [contaId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Fazenda {
  id          String   @id @default(cuid())
  contaId     String
  conta       Conta    @relation(fields: [contaId], references: [id])
  nome        String
  localizacao Json?
  hectares    Float?
  animais     Animal[]
  lotes       Lote[]
  pais        Pai[]
  despesas    Despesa[]
  receitas    Receita[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contaId])
}

model Pai {
  id          String   @id @default(cuid())
  fazendaId   String
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])
  nome        String
  descricao   String?
  animais     Animal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fazendaId])
}

model Animal {
  id          String        @id @default(cuid())
  fazendaId   String
  fazenda     Fazenda       @relation(fields: [fazendaId], references: [id])
  prefixo     String
  numero      Int
  brinco      String        @unique
  sexo        Sexo?
  paiId       String?
  pai         Pai?          @relation(fields: [paiId], references: [id], onDelete: SetNull)
  nascimento  DateTime?
  origem      String?
  fotoUrl     String?
  status      StatusAnimal  @default(ATIVO)
  loteId      String?
  lote        Lote?         @relation(fields: [loteId], references: [id])
  pesagens    Pesagem[]
  receitaId   String?
  receita     Receita?      @relation(fields: [receitaId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([receitaId])

  @@index([fazendaId])
  @@index([loteId])
  @@index([paiId])
  @@index([prefixo, numero])
}

model Lote {
  id          String   @id @default(cuid())
  fazendaId   String
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])
  nome        String
  prefixo     String?
  capacidade  Int?
  animais     Animal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fazendaId])
  @@unique([fazendaId, nome])
}

model Pesagem {
  id          String        @id @default(cuid())
  animalId    String
  animal      Animal        @relation(fields: [animalId], references: [id])
  data        DateTime      @default(now())
  peso        Float
  flag        StatusAnimal
  observacao  String?
  createdAt   DateTime      @default(now())
}

enum CategoriaDespesa {
  PESSOAL
  COMBUSTIVEL
  RACAO
  MANUTENCAO
  MEDICAMENTOS
  OUTROS
}

model Despesa {
  id          String           @id @default(cuid())
  fazendaId   String
  fazenda     Fazenda          @relation(fields: [fazendaId], references: [id])
  descricao   String
  valor       Float
  data        DateTime         @default(now())
  categoria   CategoriaDespesa
  observacao  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([fazendaId])
  @@index([data])
}

enum CategoriaReceita {
  VENDA_ANIMAIS
  LEITE
  SERVICOS
  OUTROS
}

model Receita {
  id          String           @id @default(cuid())
  fazendaId   String
  fazenda     Fazenda          @relation(fields: [fazendaId], references: [id])
  descricao   String
  valor       Float
  data        DateTime         @default(now())
  categoria   CategoriaReceita
  observacao  String?
  animais     Animal[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([fazendaId])
  @@index([data])
}


